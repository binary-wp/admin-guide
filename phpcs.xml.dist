<?xml version="1.0"?>
<ruleset name="Admin Guide Builder">
	<description>Security, i18n and compatibility checks — the WPCS sniffs WordPress.org plugin review cares about.</description>

	<file>admin-guide.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>integrations/functions</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="admin-guide-builder"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="Generic.PHP.ForbiddenFunctions"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.8"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
